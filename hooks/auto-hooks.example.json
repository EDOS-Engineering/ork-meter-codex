{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -B \"${PLUGIN_ROOT}/hooks/post_tool_use.py\"",
            "timeout": 15,
            "statusMessage": "Reducing oversized command output"
          }
        ]
      }
    ]
  }
}
